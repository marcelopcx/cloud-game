# Copiar a .env y ajustar. Lo leen compose.yaml (contenedor de PostgreSQL)
# y game-crud (Spring, vía resources/application.properties). Una variable de entorno real tiene
# prioridad sobre este archivo.

# Conexión
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cloud_game
DB_USER=cloudgame
DB_PASSWORD=cloudgame

# Pool de conexiones (HikariCP en Spring)
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_MS=5000

# OpenAPI en /v3/api-docs (lo lee Scalar en game-api). false lo apaga.
API_DOCS_ENABLED=true

# Primer administrador del panel: se crea solo si la tabla ADMIN está vacía.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Imágenes del catálogo (subidas desde game-admin, servidas en /media/). En el servidor van al
# volumen catalog-images (/var/lib/cloudgame/images); en desarrollo, a una carpeta local.
IMAGES_ROOT=/tmp/cloudgame-images
IMAGES_MAX_MB=25
