# Copiar a .env y ajustar antes de ./scripts/deploy.sh

# Juego (carpeta bajo games/)
GAME=supertuxkart

# Identificador de la estación en /health
STATION_ID=station-1

# WebRTC + HTTPS: IP o hostname que usa el navegador (no dejar localhost en servidor)
# deploy.sh completa esto solo si están vacíos o en localhost
ICE_HOST_IPS=
PUBLIC_HOST=

# public = IP pública enrutable; all = LAN / Jetson sin IP pública
ICE_HOST_POLICY=all

ICE_SERVERS=stun:stun.l.google.com:19302

# Certificado HTTPS del cliente: self = autofirmado; acme = Let's Encrypt para
# PUBLIC_HOST (con IP pública, perfil shortlived de 6 días, renovación automática).
# acme requiere TCP 80 abierto desde internet (challenge HTTP-01).
TLS_CERT=self
# Opcional: contacto de la cuenta ACME
ACME_EMAIL=

# Se rellena al detectar PUBLIC_HOST (deploy.sh / configure-external.sh)
CORS_ORIGINS=

STATION_FPS=60
STATION_VIDEO_BITRATE=5000000

# Stream a menor resolución que el juego; el navegador lo agranda con FSR.
# Vacío = misma resolución que STATION_SIZE. Punto de partida: 854x480 o 960x540
# con STATION_VIDEO_BITRATE=2500000. Filtro: bicubic (default) o lanczos si sobra CPU.
STATION_STREAM_SIZE=
STATION_STREAM_SCALER=bicubic
IDLE_TIMEOUT_S=300

# GPU NVIDIA: deploy.sh lo agrega solo si detecta el runtime nvidia
# COMPOSE_FILES="-f compose.yaml -f compose.gpu.yaml"

# Game Loader (compose.loader.yaml): crea y destruye los contenedores de estación
# Token compartido entre el Dispatcher y el loader (obligatorio; deploy-loader.sh lo genera)
LOADER_API_TOKEN=
# Estaciones simultáneas (puertos 8200+, displays :200+)
LOADER_MAX_CONTAINERS=4
LOADER_GPU=false
# false solo en Docker Desktop (Mac) sin /dev/uinput
LOADER_UINPUT=true

# Game Dispatcher (compose.loader.yaml): reparte estaciones, cola, pool mínimo e inactividad
# Bearer de la API admin (/stations, /pool); deploy-loader.sh lo genera si está vacío
DISPATCHER_API_TOKEN=
# false = no crea estaciones por adelantado (ignora minContainers del catálogo)
DISPATCHER_WARM_POOL=true
# Partida sin input: se termina y la estación vuelve al pool (reemplaza a IDLE_TIMEOUT_S en este modo)
DISPATCHER_INACTIVITY_TIMEOUT_S=300
# Estación libre más de esto: se destruye si el juego queda por encima de su mínimo
DISPATCHER_FREE_TTL_S=600
# Estación asignada que el cliente no lanza en este tiempo: se libera
DISPATCHER_CLAIM_TIMEOUT_S=60
# Partida sin conexión WebRTC más de esto: se libera
DISPATCHER_DISCONNECT_GRACE_S=30

# Catálogo (compose.loader.yaml: db + game-crud + game-admin)
# deploy-loader.sh genera DB_PASSWORD y ADMIN_PASSWORD si están vacías.
# DB_PASSWORD solo aplica al crear el volumen de PostgreSQL por primera vez.
DB_PORT=5433
DB_NAME=cloud_game
DB_USER=cloudgame
DB_PASSWORD=
# Primer administrador de https://<host>/admin/, /docs/ y /api-docs/: game-crud lo crea solo si la
# tabla ADMIN está vacía. Los demás (y los cambios de contraseña) se manejan desde el panel.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Sesión de jugadores y saves (game-crud + game-dispatcher). Sin sesión se juega igual, sin progreso.
# Secreto compartido de los tokens (mín. 32 caracteres); deploy-loader.sh lo genera si está vacío.
# Vacío en desarrollo = solo jugadores anónimos.
CLOUDGAME_JWT_SECRET=
# Tope de un save (.tar.gz) por usuario y juego
SAVES_MAX_MB=256
# Tope de una imagen del catálogo subida desde /admin/ (nginx acepta hasta 32 MB)
IMAGES_MAX_MB=25
